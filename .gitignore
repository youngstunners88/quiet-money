__pycache__/
*.pyc
.pytest_cache/
.venv/
.env
.env.local
# media is rebuilt or shipped as CI artifacts; state, scripts, reports, and the brand kit are committed
production/output/
production/cache/
distribution/queue/**/*.mp4
distribution/queue/**/*.jpg
distribution/queue/**/*.wav
channel/services/**/*.zip
channel/products/**/*.zip
channel/services/brand-kit/samples/*/*.png
!channel/services/brand-kit/samples/*/preview.png
channel/flow/inbox/
channel/flow/used/
distribution/queue/**/kit/**/*.png
distribution/queue/**/kit/*.mp3
# built website (deployed to the gh-pages branch by CI)
site/
state/memory.db

# derived caches (rebuilt on demand)
state/embeddings.db
state/embeddings.db-*

# listing packs: pictures and video are rebuilt by `python -m faceless listing build` (and sent to the owner); copy, checklists and reports are committed
channel/shop/*/etsy/images/
channel/shop/*/etsy/video.mp4
channel/shop/*/gumroad/*.jpg
channel/shop/*.zip

# personal Claude Code overrides
.claude/settings.local.json
channel/host/tmp/
state/tmp/
music/videos/**/*.mp4
production/cache/songvideo/

# planner: the drawn pictures are rebuilt by `python -m faceless planner build`; the owner pictures in assets/planner/source and the PDFs are committed
assets/planner/generated/
assets/planner/clean-before-after.jpg
# Paid product files never go in the public repo (anyone could download them free). Rebuild them with
# `python -m faceless products` and `python -m faceless planner build`; Gumroad holds the copies buyers get.
channel/products/**/*.pdf
channel/products/**/*.xlsx

# The Brain keeps raw transcripts out of git (other people's words; the repo is public)
state/brain/raw/
state/brain/paid/

# claude-code-orchestrator MCP: dependencies, build output and worker logs stay local
claude-code-orchestrator/node_modules/
claude-code-orchestrator/dist/
claude-code-orchestrator/logs/
state/brain/skill-drafts/

# The service desk's working data: real company names, researched signals and unsent outreach copy
# do not belong in a public repo. The schema, templates, positioning and proof files ARE committed.
channel/services/web3-video/leads/*.json
channel/services/web3-video/outbound/*.json
channel/services/web3-video/outcomes.jsonl
channel/services/web3-video/reviews/

# the weekly audio edition: the mp3 is rebuilt by `python -m faceless podcast build`; EPISODE.md and episode.json are committed
distribution/podcast/**/*.mp3
# the weekly long-form: episode.mp4 is rebuilt by `python -m faceless longform build`; EPISODE.md, episode.json and thumbnail.jpg are committed
distribution/longform/**/*.mp4
# studio mode: client orders (briefs and concept sheets) stay private; the samples/ gallery is committed
channel/services/studio/orders/
# collaboration notes name real shows and hosts: drafts stay local; state/collab-*.json(l) holds hashes only
channel/collab/drafts/
channel/services/studio/samples/*/*.jpg
channel/services/studio/samples/*/sheet.pdf
# second-language editions: the video is rebuilt from script.json; POST.md, meta.json and script.json are committed
distribution/editions/**/*.mp4

# rendered hero edits (large, reproducible with tools/hero_edit.py)
channel/flow/hero/*.mp4
channel/services/web3-video/outbound/drafts-*.md
