{
  "mcpServers": {
    "quiet-planner": {
      "command": "python",
      "args": [
        "-m",
        "faceless.planner_mcp"
      ]
    },
    "quiet-shop": {
      "command": "python",
      "args": [
        "-m",
        "faceless.shop_mcp"
      ]
    },
    "claude-code-orchestrator": {
      "command": "node",
      "args": [
        "claude-code-orchestrator/dist/index.js"
      ],
      "env": {
        "WORKER_PERMISSION_MODE": "read_only"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "--yes",
        "shadcn@4.23.0",
        "mcp"
      ]
    }
  }
}
