# Copy to .env (gitignored) to run the studio on your own machine; the keys never leave it.
# Only the first three are required. Leave a line empty to skip that provider.
GEMINI_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
COMPOSIO_API_KEY=
ELEVENLABS_API_KEY=
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
TYPESAFE_API_KEY=
