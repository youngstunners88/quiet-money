# claude-code-orchestrator settings. Copy to .env (read at start-up on Node 20.12+) or pass them with
#   claude mcp add claude-code-orchestrator -e NAME=value -- node /abs/path/dist/index.js
# Variables already set in the environment win over .env. No API key belongs here: workers use
# Claude Code's own login (or whatever auth the environment already provides).

# Widest permission mode any worker may get: read_only | standard | full_access (default read_only).
# Raising it is not enough on its own: the user must approve each such worker (asked directly through MCP
# elicitation when the client supports it; otherwise start_worker must pass confirm_write_access: true).
WORKER_PERMISSION_MODE=read_only

# Claude Code CLI used for workers (default: claude on PATH).
CLAUDE_BIN=claude

# Maximum workers running at once (default 3).
WORKER_MAX_CONCURRENT=3

# Default time limit per worker task in ms (default 600000 = 10 minutes).
WORKER_TIMEOUT_MS=600000

# Upper bound for a caller's timeout_minutes, in ms (default 7200000 = 2 hours).
WORKER_MAX_TIMEOUT_MS=7200000

# Wait between SIGTERM and SIGKILL when stopping a worker, in ms (default 5000).
WORKER_KILL_GRACE_MS=5000

# Optional: colon-separated directories; project_path must resolve inside one of them.
# WORKER_ALLOWED_ROOTS=/home/me/projects:/srv/repos

# Directory for orchestrator.jsonl (default: <this package>/logs).
# ORCHESTRATOR_LOG_DIR=/var/log/claude-code-orchestrator

# Finished workers kept for list_workers (default 50) and output lines kept per worker (default 5000).
WORKER_RETAIN_FINISHED=50
WORKER_MAX_OUTPUT_LINES=5000

# Run workers with claude --restricted (default 1): ignores settings files (their hooks and allow rules)
# and confines file tools to the project. Set 0 only if your Claude Code auth lives in a settings file.
WORKER_RESTRICTED=1

# Workers get an allowlisted environment (system basics, proxy/CA settings, Claude Code's own auth and
# provider variables), never the server's other keys. Extra comma-separated names to pass on top:
# WORKER_ENV_PASS=
# Extra comma-separated variable names to remove from the worker environment
# (CLAUDE_CODE_SESSION_ID and CLAUDE_CODE_INCLUDE_PARTIAL_MESSAGES are always removed).
# WORKER_ENV_STRIP=

# Tests only: RUN_INTEGRATION=1 runs the real-worker integration test; INTEGRATION_MODEL picks its model (default haiku).
# RUN_INTEGRATION=1
# INTEGRATION_MODEL=haiku
